# Copy to .env and fill in: `cp env.example .env`. Never commit the real .env
# (it's gitignored, and this repo's permission rules block writing to .env*).

# --- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CASEFILE_MODEL=claude-opus-5

# --- Ceilings, enforced in code by the Supervisor (see docs/guarantees.md) --
CASEFILE_BUDGET_USD=0.50
CASEFILE_MAX_STEPS=12
CASEFILE_MAX_LLM_CALLS=10
CASEFILE_MAX_SEND_BACKS=2
CASEFILE_MAX_RETRIES_PER_CALL=1

# --- Human approval gate -------------------------------------------------
# HMAC secret shared between the orchestrator and the mock claims system.
# Generate your own: `python -c "import secrets; print(secrets.token_hex(32))"`
CASEFILE_APPROVAL_SECRET=change-me-to-a-random-64-char-hex-string

# --- Storage -------------------------------------------------------------
CASEFILE_DB_PATH=/data/casefile.db

# --- Service discovery (compose overrides these to the service DNS names) --
CASEFILE_CLAIMS_SYSTEM_URL=http://localhost:8001

# --- Tracing ---------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=casefile-api
