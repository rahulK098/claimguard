# Copy to .env and fill in: `cp env.example .env`. Never commit the real .env
# (it's gitignored, and this repo's permission rules block writing to .env*).

# --- LLM provider(s) ------------------------------------------------------
# Multi-provider with automatic fallback (see docs/adr/0011-multi-provider-llm.md):
# LLM_PROVIDER picks which one is tried first. Every OTHER provider below
# that has a key set becomes an automatic fallback (fixed order: azure,
# anthropic, openrouter, groq, gemini, deepseek), then local Ollama last.
# Uncomment/fill in only the provider(s) you actually want to use -- an
# unset provider is simply skipped, not an error.
LLM_PROVIDER=azure  # azure | anthropic | openrouter | groq | gemini | deepseek | ollama

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAIMGUARD_MODEL=claude-opus-5

# Azure OpenAI (primary provider by default)
AZURE_OPENAI_KEY=
AZURE_OPENAI_KEY2=  # optional secondary key, tried if the primary fails (zero-downtime rotation)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=chat
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure pricing is contract/region-specific -- no public default exists.
# Set both to get accurate cost tracking; otherwise Azure calls are recorded
# as cost_priced=false (tracked, but the $0.00 is a placeholder, not real).
CLAIMGUARD_AZURE_INPUT_USD_PER_MTOK=
CLAIMGUARD_AZURE_OUTPUT_USD_PER_MTOK=

# OpenRouter (":free" models are $0 by definition; paid models need a rate below)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CLAIMGUARD_OPENROUTER_INPUT_USD_PER_MTOK=
CLAIMGUARD_OPENROUTER_OUTPUT_USD_PER_MTOK=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLAIMGUARD_GROQ_INPUT_USD_PER_MTOK=
CLAIMGUARD_GROQ_OUTPUT_USD_PER_MTOK=

# Gemini (has a verified built-in default rate for gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CLAIMGUARD_DEEPSEEK_INPUT_USD_PER_MTOK=
CLAIMGUARD_DEEPSEEK_OUTPUT_USD_PER_MTOK=

# Ollama (local; always eligible as the last fallback, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Ceilings, enforced in code by the Supervisor (see docs/guarantees.md) --
CLAIMGUARD_BUDGET_USD=0.50
CLAIMGUARD_MAX_STEPS=12
CLAIMGUARD_MAX_LLM_CALLS=10
CLAIMGUARD_MAX_SEND_BACKS=2
CLAIMGUARD_MAX_RETRIES_PER_CALL=1

# --- Human approval gate -------------------------------------------------
# HMAC secret shared between the orchestrator and the mock claims system.
# Generate your own: `python -c "import secrets; print(secrets.token_hex(32))"`
CLAIMGUARD_APPROVAL_SECRET=change-me-to-a-random-64-char-hex-string

# --- Storage -------------------------------------------------------------
CLAIMGUARD_DB_PATH=/data/claimguard.db
CLAIMS_SYSTEM_DB_PATH=/data/claims_system.db

# --- Service discovery (compose overrides these to the service DNS names) --
CLAIMGUARD_CLAIMS_SYSTEM_URL=http://localhost:8001

# --- Tracing ---------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=claimguard-api
